{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kindora",
  "version": "0.1.0",
  "identifier": "com.kindora.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kindora",
        "width": 1024,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Social",
    "shortDescription": "Personal AI Social Agent client.",
    "longDescription": "Kindora is an open-source personal AI social agent client that helps people discover meaningful human connections through agent-to-agent matching.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
