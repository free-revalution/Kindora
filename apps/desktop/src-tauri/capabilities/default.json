{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window — V0.1 permissions for LAN transport, OS keychain, and SQLite.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close"
  ]
}
