# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Tauri / Rust
# NOTE: `apps/desktop/src-tauri/Cargo.lock` is deliberately NOT ignored.
# This crate builds an application (a shipped desktop binary), not a library,
# so the lockfile must be committed: it is what makes a clean-clone build
# reproducible and pins the dependency versions CI resolves.
src-tauri/target/
src-tauri/gen/
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# Experiments — Rust build artifacts
experiments/**/target/

# Test / coverage
coverage/
.nyc_output/

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
*~

# Env
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cache
.cache/
.eslintcache
.parcel-cache
.vite/

# Secrets — never commit
**/secrets/
**/*.key
**/*.pem
